fn bool program() {
    workloadTotals[0] = runSensors();
    workloadTotals[1] = runInventory();
    workloadTotals[2] = runGrids();
    workloadTotals[3] = runParticles();
    echo "Compilation benchmark checksums: sensors, inventory, grids, particles";
    echo workloadTotals[0];
    echo workloadTotals[1];
    echo workloadTotals[2];
    echo workloadTotals[3];
    bool passed = workloadTotals[0] == 860938;
    passed = passed and workloadTotals[1] == 2854906;
    passed = passed and workloadTotals[2] == 12400860;
    passed = passed and workloadTotals[3] == 20272961;
    echo passed;
    return passed;
}
