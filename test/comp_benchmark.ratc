// Inventory: 900 batches with varied inputs and coefficients.

fn int processOrdersBatch0(int seed) {
    Inventory stock;
    int item = 0;
    while (item < 8) {
        stock.items[item].price = 20 + seed + item * 3;
        stock.items[item].sold = 0;
        int bin = 0;
        while (bin < 4) {
            stock.items[item].bins[bin] = seed + item + bin * 3;
            bin = bin + 1;
        }
        item = item + 1;
    }
    stock.rejected = 0;
    Inventory before = stock;
    Invoice initial;
    initial.subtotal = 0;
    Invoice& invoice = new Invoice& { initial };
    int orderCount = 12;
    int[]& receipts = new int[orderCount]&;
    int& unitsSold = new int& { 0 };
    int order = 0;
    while (order < orderCount) {
        int product = order * 5 + seed;
        product = product - (product / 8) * 8;
        int bin = order - (order / 4) * 4;
        int quantity = 1 + order - (order / 3) * 3;
        receipts[order] = 0;
        if (stock.items[product].bins[bin] >= quantity) {
            stock.items[product].bins[bin] = stock.items[product].bins[bin] - quantity;
            stock.items[product].sold = stock.items[product].sold + quantity;
            int charge = stock.items[product].price * quantity;
            receipts[order] = charge;
            invoice.subtotal = invoice.subtotal + charge;
            invoice.categoryTotals[bin] = invoice.categoryTotals[bin] + charge;
            unitsSold.value = unitsSold.value + quantity;
        } else {
            stock.rejected = stock.rejected + 1;
        }
        order = order + 1;
    }
    int remaining = 0;
    int original = 0;
    int sold = 0;
    item = 0;
    while (item < 8) {
        int bin = 0;
        while (bin < 4) {
            remaining = remaining + stock.items[item].bins[bin];
            original = original + before.items[item].bins[bin];
            bin = bin + 1;
        }
        sold = sold + stock.items[item].sold;
        item = item + 1;
    }
    int receiptTotal = 0;
    order = 0;
    while (order < orderCount) {
        receiptTotal = receiptTotal + receipts[order];
        order = order + 1;
    }
    int categoryTotal = 0;
    int category = 0;
    while (category < 4) {
        categoryTotal = categoryTotal + invoice.categoryTotals[category];
        category = category + 1;
    }
    bool balanced = original == remaining + sold;
    balanced = balanced and sold == unitsSold.value;
    balanced = balanced and receiptTotal == invoice.subtotal;
    balanced = balanced and categoryTotal == receiptTotal;
    if (balanced == false) { return 0; }
    return receiptTotal + remaining * 3 + unitsSold.value * 7 + stock.rejected;
}

