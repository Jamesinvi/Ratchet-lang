// Grids: 900 batches with varied inputs and coefficients.

fn int updateGridBatch0(int seed) {
    Grid current;
    int row = 0;
    while (row < 8) {
        int column = 0;
        while (column < 8) {
            current.rows[row].cells[column] = seed + row * 2 + column * 1;
            column = column + 1;
        }
        row = row + 1;
    }
    Grid next = current;
    int step = 0;
    while (step < 3) {
        row = 1;
        while (row < 7) {
            int column = 1;
            while (column < 7) {
                int center = current.rows[row].cells[column];
                int north = current.rows[row - 1].cells[column];
                int south = current.rows[row + 1].cells[column];
                int west = current.rows[row].cells[column - 1];
                int east = current.rows[row].cells[column + 1];
                int average = (center * 4 + north + south + west + east) / 8;
                if (row == column) {
                    average = average + 1;
                }
                next.rows[row].cells[column] = average;
                column = column + 1;
            }
            row = row + 1;
        }
        current = next;
        step = step + 1;
    }
    Grid& shared = new Grid& { current };
    int[8] rowTotals;
    int[8] columnTotals;
    row = 0;
    while (row < 8) {
        rowTotals[row] = 0;
        columnTotals[row] = 0;
        row = row + 1;
    }
    row = 0;
    while (row < 8) {
        int column = 0;
        while (column < 8) {
            int value = shared.rows[row].cells[column];
            rowTotals[row] = rowTotals[row] + value;
            columnTotals[column] = columnTotals[column] + value;
            column = column + 1;
        }
        row = row + 1;
    }
    int total = 0;
    int checkTotal = 0;
    int diagonal = 0;
    int weighted = 0;
    row = 0;
    while (row < 8) {
        total = total + rowTotals[row];
        checkTotal = checkTotal + columnTotals[row];
        diagonal = diagonal + shared.rows[row].cells[row];
        weighted = weighted + rowTotals[row] * (row + 1);
        row = row + 1;
    }
    if (total != checkTotal) { return 0; }
    return weighted + diagonal * 5 + total;
}

