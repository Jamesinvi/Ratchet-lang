// Particles: 900 batches with varied inputs and coefficients.

fn int advanceParticlesBatch0(int seed) {
    int count = 12;
    Particle[]& particles = new Particle[count]&;
    int i = 0;
    while (i < count) {
        Particle particle;
        particle.position.x = (seed as float) * 0.25f + (i as float);
        particle.position.y = (i as float) * 0.5f;
        particle.position.z = 0.0f;
        particle.velocity.x = 0.25f;
        particle.velocity.y = 0.25f;
        particle.velocity.z = 0.125f;
        particle.age = 0;
        particles[i] = particle;
        i = i + 1;
    }
    int step = 0;
    while (step < 4) {
        i = 0;
        while (i < count) {
            Vec3 position = particles[i].position;
            Vec3 velocity = particles[i].velocity;
            Vec3 displacement = velocity.scale(0.5f);
            position = position.add(displacement);
            if (position.x > 16.0f) {
                position.x = 16.0f;
                velocity.x = 0.0f - velocity.x;
            }
            particles[i].position = position;
            particles[i].velocity = velocity;
            particles[i].history[step] = position.dot(position);
            particles[i].age = particles[i].age + 1;
            i = i + 1;
        }
        step = step + 1;
    }
    Particle&[]& selected = new Particle&[2]&;
    selected[0] = new Particle& { particles[0] };
    selected[1] = new Particle& { particles[count - 1] };
    Particle& first = selected[0];
    first.age = first.age + 2;
    selected[1].position.x = selected[1].position.x + 0.25f;
    selected[0].history[0] = selected[0].history[0] + 1.0f;
    int& energy = new int& { 0 };
    int totalAge = 0;
    int checksum = 0;
    i = 0;
    while (i < count) {
        int sample = 0;
        while (sample < 4) {
            float history = particles[i].history[sample];
            energy.value = energy.value + ((history * 4.0f) as int);
            sample = sample + 1;
        }
        totalAge = totalAge + particles[i].age;
        float x = particles[i].position.x;
        float y = particles[i].position.y;
        float z = particles[i].position.z;
        checksum = checksum + (((x + y + z) * 4.0f) as int);
        i = i + 1;
    }
