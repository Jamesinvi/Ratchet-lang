// 3600 executable batches; expected totals: 860938, 2854906, 12400860, 20272961.
// Compilation benchmark: independent batches of four small application workloads.
// All batches execute. program() prints four checksums and whether they match.
// Keep batches separate so a large source file does not require one enormous frame.
// Array lengths and loop bounds are explicit; methods operate on named values.

struct Vec3 {
    float x;
    float y;
    float z;

    method Vec3 add(Vec3 other) {
        Vec3 result;
        result.x = this.x + other.x;
        result.y = this.y + other.y;
        result.z = this.z + other.z;
        return result;
    }

    method Vec3 scale(float factor) {
        Vec3 result;
        result.x = this.x * factor;
        result.y = this.y * factor;
        result.z = this.z * factor;
        return result;
    }

    method float dot(Vec3 other) {
        return this.x * other.x + this.y * other.y + this.z * other.z;
    }
}

struct SampleWindow {
    float[16] raw;
    float[16] filtered;
    bool[16] active;
    int[4] histogram;
}

struct StockItem {
    int price;
    int[4] bins;
    int sold;
}

struct Inventory {
    StockItem[8] items;
    int rejected;
}

struct Invoice {
    int subtotal;
    int[4] categoryTotals;
}

struct GridRow {
    int[8] cells;
}

struct Grid {
    GridRow[8] rows;
}

struct Particle {
    Vec3 position;
    Vec3 velocity;
    float[4] history;
    int age;
}

int[4] workloadTotals;

fn float calibrate(float value, float gain, float bias) {
    return value * gain + bias;
}

fn int sampleBucket(float value) {
    if (value < 8.0f) { return 0; }
    if (value < 16.0f) { return 1; }
    if (value < 24.0f) { return 2; }
    return 3;
}

fn float sumSamples(in float[16] samples) {
    int i = 0;
    float total = 0.0f;
    while (i < 16) {
        total = total + samples[i];
        i = i + 1;
    }
    return total;
}

// Sensors: 900 batches with varied inputs and coefficients.

fn int filterSensorBatch0(int seed) {
    SampleWindow samples;
    int i = 0;
    while (i < 16) {
        float raw = (seed as float) + (i as float) * 0.5f;
        samples.raw[i] = calibrate(raw, 0.5f, 0.0f);
        samples.filtered[i] = 0.0f;
        samples.active[i] = false;
        i = i + 1;
    }
    i = 0;
    while (i < 4) {
        samples.histogram[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 16) {
        int previous = i - 1;
        int next = i + 1;
        if (previous < 0) { previous = 0; }
        if (next >= 16) { next = 15; }
        float left = samples.raw[previous];
        float center = samples.raw[i];
        float right = samples.raw[next];
        float filtered = (left + center * 2.0f + right) * 0.25f;
        samples.filtered[i] = filtered;
        samples.active[i] = filtered > 4.0f;
        int bucket = sampleBucket(calibrate(filtered, 1.0f, 0.0f));
        samples.histogram[bucket] = samples.histogram[bucket] + 1;
        i = i + 1;
    }
    float total = sumSamples(samples.filtered);
    float average = total / 16.0f;
    float[16] residuals;
    int activeCount = 0;
    int crossings = 0;
    i = 0;
    while (i < 16) {
        float residual = samples.filtered[i] - average;
        residuals[i] = residual * residual;
        if (samples.active[i]) {
            activeCount = activeCount + 1;
        }
        if (i > 0) {
            if (samples.active[i] != samples.active[i - 1]) {
                crossings = crossings + 1;
            }
        }
        i = i + 1;
    }
    float variance = sumSamples(residuals) / 16.0f;
    int weightedBins = 0;
    i = 0;
    while (i < 4) {
        weightedBins = weightedBins + samples.histogram[i] * (i + 1);
        i = i + 1;
    }
    int checksum = (total * 4.0f) as int;
    checksum = checksum + ((variance * 16.0f) as int);
    checksum = checksum + activeCount * 7 + crossings * 11;
    return checksum + weightedBins;
}

