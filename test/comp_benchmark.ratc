    while (i < 16) {
        float raw = (seed as float) + (i as float) * 0.5f;
        samples.raw[i] = calibrate(raw, 1.0f, 1.0f);
        samples.filtered[i] = 0.0f;
        samples.active[i] = false;
        i = i + 1;
    }
    i = 0;
    while (i < 4) {
        samples.histogram[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 16) {
        int previous = i - 1;
        int next = i + 1;
        if (previous < 0) { previous = 0; }
        if (next >= 16) { next = 15; }
        float left = samples.raw[previous];
        float center = samples.raw[i];
        float right = samples.raw[next];
        float filtered = (left + center * 2.0f + right) * 0.25f;
        samples.filtered[i] = filtered;
        samples.active[i] = filtered > 8.0f;
        int bucket = sampleBucket(calibrate(filtered, 1.0f, 0.0f));
        samples.histogram[bucket] = samples.histogram[bucket] + 1;
        i = i + 1;
    }
    float total = sumSamples(samples.filtered);
    float average = total / 16.0f;
    float[16] residuals;
    int activeCount = 0;
    int crossings = 0;
    i = 0;
    while (i < 16) {
        float residual = samples.filtered[i] - average;
        residuals[i] = residual * residual;
        if (samples.active[i]) {
            activeCount = activeCount + 1;
        }
        if (i > 0) {
            if (samples.active[i] != samples.active[i - 1]) {
                crossings = crossings + 1;
            }
        }
        i = i + 1;
    }
    float variance = sumSamples(residuals) / 16.0f;
    int weightedBins = 0;
    i = 0;
    while (i < 4) {
        weightedBins = weightedBins + samples.histogram[i] * (i + 1);
        i = i + 1;
    }
    int checksum = (total * 4.0f) as int;
    checksum = checksum + ((variance * 16.0f) as int);
    checksum = checksum + activeCount * 7 + crossings * 11;
    return checksum + weightedBins;
}

