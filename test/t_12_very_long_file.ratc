// A deterministic settlement simulation, not declaration-count filler.
// All subsystems run for four days and contribute to checked checkpoints.
// State is bounded: terrain 0..12, water 0..80, people 0..40, roads 0..3.
// Integer checksums are reduced before multiplication; floats use halves.

struct Tile
{
    int elevation;
    int water;
    int heat;
    int population;
    int food;
    int ore;
    int road;
    int traffic;
    int harvest;
    bool blocked;
}

struct World
{
    Tile[64] tiles;
    int day;
    int rain;
    int drained;
    int produced;
    int eaten;
    int mined;
    int emigrated;
}

struct Treasury
{
    int cash;
    int income;
    int expense;
    int trades;
    int taxes;
    int tolls;
    int aid;

    method null credit(int amount)
    {
        this.cash = this.cash + amount;
        this.income = this.income + amount;
    }

    method null debit(int amount)
    {
        this.cash = this.cash - amount;
        this.expense = this.expense + amount;
    }

    method int balance()
    {
        return this.income - this.expense;
    }
}

struct RunningStats
{
    int count;
    int total;
    int minimum;
    int maximum;

    method null observe(int value)
    {
        if (this.count == 0)
        {
            this.minimum = value;
            this.maximum = value;
        }
        else
        {
            if (value < this.minimum)
            {
                this.minimum = value;
            }
            if (value > this.maximum)
            {
                this.maximum = value;
            }
        }
        this.count = this.count + 1;
        this.total = this.total + value;
    }

    method int average()
    {
        if (this.count == 0)
        {
            return 0;
        }
        return this.total / this.count;
    }

    method int spread()
    {
        return this.maximum - this.minimum;
    }
}

struct City
{
    World world;
    Treasury money;
    int warnings;
    int routeScore;
    int history;
}

struct Routes
{
    int[64] cost;
    bool[64] visited;
    int reached;
    int sum;
}

struct Report
{
    int water;
    int food;
    int population;
    int roads;
    int ore;
    int heat;
    int health;
    int finance;
    int routes;
    int checksum;
}

struct Inspection
{
    int errors;
    int checks;
    int signature;

    method null check(bool condition, int weight)
    {
        this.checks = this.checks + 1;
        if (condition)
        {
            this.signature = this.signature + weight;
        }
        else
        {
            this.errors = this.errors + 1;
        }
    }
}

fn int remainder(int value, int divisor)
{
    return value - (value / divisor) * divisor;
}

fn int minimum(int left, int right)
{
    if (left < right)
    {
        return left;
    }
    return right;
}

fn int maximum(int left, int right)
{
    if (left > right)
    {
        return left;
    }
    return right;
}

fn int absolute(int value)
{
    if (value < 0)
    {
        return 0 - value;
    }
    return value;
}

fn int clamp(int value, int low, int high)
{
    return maximum(low, minimum(high, value));
}

fn int tileIndex(int x, int y)
{
    return y * 8 + x;
}

fn bool inside(int x, int y)
{
    return x >= 0 and x < 8 and y >= 0 and y < 8;
}

fn bool onBorder(int x, int y)
{
    return x == 0 or y == 0 or x == 7 or y == 7;
}

fn int folded(int value)
{
    return remainder(value, 1000003);
}

// Initial conditions deliberately cross every later threshold.
fn Tile makeTile(int x, int y)
{
    Tile tile;
    tile.elevation = remainder(x * 3 + y * 5, 13);
    tile.heat = 12 + remainder(x + y * 2, 9);
    tile.blocked = tile.elevation > 10;
    return tile;
}

fn null seedTerrain(inout City city)
{
    int y = 0;
    while (y < 8)
    {
        int x = 0;
        while (x < 8)
        {
            city.world.tiles[tileIndex(x, y)] = makeTile(x, y);
            x = x + 1;
        }
        y = y + 1;
    }
}

fn null seedWater(inout City city)
{
    int i = 0;
    while (i < 64)
    {
        int elevation = city.world.tiles[i].elevation;
        city.world.tiles[i].water = 24 - elevation + remainder(i, 5);
        i = i + 1;
    }
}

fn null seedPopulation(inout City city)
{
    int i = 0;
    while (i < 64)
    {
        if (city.world.tiles[i].blocked == false)
        {
            city.world.tiles[i].population = 3 + remainder(i * 3, 11);
        }
        i = i + 1;
    }
}

fn null seedFood(inout City city)
{
    int i = 0;
    while (i < 64)
    {
        int population = city.world.tiles[i].population;
        city.world.tiles[i].food = population * 2 + remainder(i, 7);
        i = i + 1;
    }
}

fn null seedRoads(inout City city)
{
    int y = 0;
    while (y < 8)
    {
        int x = 0;
        while (x < 8)
        {
            int i = tileIndex(x, y);
            if (x == 3 or y == 4)
            {
                city.world.tiles[i].road = 2;
            }
            x = x + 1;
        }
        y = y + 1;
    }
}

fn null seedResources(inout City city)
{
    int i = 0;
    while (i < 64)
    {
        city.world.tiles[i].ore = 10 + remainder(i * 7, 19);
        i = i + 1;
    }
}

fn City seedCity()
{
    City city;
    seedTerrain(city);
    seedWater(city);
    seedPopulation(city);
    seedFood(city);
    seedRoads(city);
    seedResources(city);
    city.money.credit(2000);
    return city;
}

// Climate combines staged, order-independent buffers with edge drainage.
fn int seasonRain(int day)
{
    if (day == 2)
    {
        return 9;
    }
    if (day == 4)
    {
        return 2;
    }
    return 5;
}

fn int seasonHeat(int day)
{
    if (day < 3)
    {
        return 2;
    }
    return 4;
}

fn int effectiveRain(Tile tile, int day)
{
    int rain = seasonRain(day);
    if (tile.elevation > 8)
    {
        rain = rain + 2;
    }
    if (tile.road > 1)
    {
        rain = maximum(0, rain - 1);
    }
    return rain;
}

fn null addRain(inout City city)
{
    int i = 0;
    while (i < 64)
    {
        int rain = effectiveRain(city.world.tiles[i], city.world.day);
        city.world.tiles[i].water = city.world.tiles[i].water + rain;
        city.world.rain = city.world.rain + rain;
        i = i + 1;
    }
}

fn null evaporate(inout City city)
{
    int i = 0;
    while (i < 64)
    {
        int loss = city.world.tiles[i].heat / 8;
        loss = minimum(loss, city.world.tiles[i].water);
        city.world.tiles[i].water = city.world.tiles[i].water - loss;
        city.world.drained = city.world.drained + loss;
        i = i + 1;
    }
}

fn null drainBorder(inout City city)
{
    int y = 0;
    while (y < 8)
    {
        int x = 0;
        while (x < 8)
        {
            if (onBorder(x, y))
            {
                int i = tileIndex(x, y);
                int loss = city.world.tiles[i].water / 5;
                city.world.tiles[i].water = city.world.tiles[i].water - loss;
                city.world.drained = city.world.drained + loss;
            }
            x = x + 1;
        }
        y = y + 1;
    }
}

fn int neighborWater(in World world, int x, int y)
{
    int total = 0;
    if (inside(x - 1, y))
    {
        total = total + world.tiles[tileIndex(x - 1, y)].water;
    }
    if (inside(x + 1, y))
    {
        total = total + world.tiles[tileIndex(x + 1, y)].water;
    }
    if (inside(x, y - 1))
    {
        total = total + world.tiles[tileIndex(x, y - 1)].water;
    }
    if (inside(x, y + 1))
    {
        total = total + world.tiles[tileIndex(x, y + 1)].water;
    }
    return total;
}

fn int neighborCount(int x, int y)
{
    int count = 4;
    if (x == 0 or x == 7)
    {
        count = count - 1;
    }
    if (y == 0 or y == 7)
    {
        count = count - 1;
    }
    return count;
}

fn null redistributeWater(inout City city)
{
    int[64] next;
    int y = 0;
    while (y < 8)
    {
        int x = 0;
        while (x < 8)
        {
            int i = tileIndex(x, y);
            int total = neighborWater(city.world, x, y);
            int neighbors = neighborCount(x, y);
            next[i] = (city.world.tiles[i].water * 4 + total) / (4 + neighbors);
            x = x + 1;
        }
        y = y + 1;
    }
    int i = 0;
    while (i < 64)
    {
        city.world.tiles[i].water = clamp(next[i], 0, 80);
        i = i + 1;
    }
}

fn null updateHeat(inout City city)
{
    int i = 0;
    while (i < 64)
    {
        int heat = city.world.tiles[i].heat + seasonHeat(city.world.day);
        if (city.world.tiles[i].water > 20)
        {
            heat = heat - 2;
        }
        if (city.world.tiles[i].blocked)
        {
            heat = heat - 1;
        }
        city.world.tiles[i].heat = clamp(heat, 0, 40);
        i = i + 1;
    }
}

fn null updateClimate(inout City city)
{
    addRain(city);
    evaporate(city);
    drainBorder(city);
    redistributeWater(city);
    updateHeat(city);
}

// Farming mutates independent resources and records conservation totals.
fn int growthForTile( Tile tile)
{
    if (tile.blocked)
    {
        return 0;
    }
    int growth = tile.water / 4;
    if (tile.heat > 24)
    {
        growth = growth - 2;
    }
    if (tile.population > 8)
    {
        growth = growth + 1;
    }
    return maximum(0, growth);
}

fn null irrigateFields(inout City city)
{
    int i = 0;
    while (i < 64)
    {
        if (city.world.tiles[i].population > 0 and city.world.tiles[i].water < 18)
        {
            city.world.tiles[i].water = city.world.tiles[i].water + 3;
            city.money.debit(2);
        }
        i = i + 1;
    }
}

fn null growFood(inout City city)
{
    int i = 0;
    while (i < 64)
    {
        int growth = growthForTile(city.world.tiles[i]);
        city.world.tiles[i].food = city.world.tiles[i].food + growth;
        city.world.tiles[i].harvest = growth;
        city.world.produced = city.world.produced + growth;
        i = i + 1;
    }
}

fn int populationDemand(Tile tile)
{
    int demand = tile.population;
    if (tile.heat > 26)
    {
        demand = demand + tile.population / 4;
    }
    return demand;
}

fn null consumeFood(inout City city)
{
    int i = 0;
    while (i < 64)
    {
        int demand = populationDemand(city.world.tiles[i]);
        int consumed = minimum(demand, city.world.tiles[i].food);
        city.world.tiles[i].food = city.world.tiles[i].food - consumed;
        city.world.eaten = city.world.eaten + consumed;
        if (consumed < demand)
        {
            city.warnings = city.warnings + 1;
        }
        i = i + 1;
    }
}

fn null tradeSurplusFood(inout City city)
{
    int i = 0;
    while (i < 64)
    {
        int reserve = city.world.tiles[i].population * 2 + 5;
        int surplus = maximum(0, city.world.tiles[i].food - reserve);
        if (surplus > 0)
        {
            city.world.tiles[i].food = city.world.tiles[i].food - surplus;
            city.money.trades = city.money.trades + surplus;
            city.money.credit(surplus * 2);
        }
        i = i + 1;
    }
}

fn null updateAgriculture(inout City city)
{
    irrigateFields(city);
    growFood(city);
    consumeFood(city);
    tradeSurplusFood(city);
}

// Population changes depend on the preceding climate and harvest stages.
fn bool canSettle(Tile tile)
{
    return tile.blocked == false and tile.water >= 15 and tile.food >= tile.population;
}

fn null settleNewcomers(inout City city)
{
    int i = 0;
    while (i < 64)
    {
        if (canSettle(city.world.tiles[i]))
        {
            int arrivals = 1 + remainder(i + city.world.day, 2);
            city.world.tiles[i].population = minimum(40, city.world.tiles[i].population + arrivals);
        }
        i = i + 1;
    }
}

fn null evacuateFlooded(inout City city)
{
    int i = 0;
    while (i < 64)
    {
        if (city.world.tiles[i].water > 28)
        {
            int leaving = city.world.tiles[i].population / 3;
            city.world.tiles[i].population = city.world.tiles[i].population - leaving;
            city.world.emigrated = city.world.emigrated + leaving;
        }
        i = i + 1;
    }
}

fn null moveCrowding(inout City city)
{
    int i = 0;
    while (i < 63)
    {
        int next = i + 1;
        if (city.world.tiles[i].population > 12 and city.world.tiles[next].blocked == false)
        {
            if (city.world.tiles[next].population < 8)
            {
                city.world.tiles[i].population = city.world.tiles[i].population - 2;
                city.world.tiles[next].population = city.world.tiles[next].population + 2;
            }
        }
        i = i + 1;
    }
}

fn int taxForTile( Tile tile)
{
    if (tile.population == 0)
    {
        return 0;
    }
    int tax = tile.population * 2;
    if (tile.food < tile.population)
    {
        tax = tax / 2;
    }
    return tax;
}

fn null collectTaxes(inout City city)
{
    int total = 0;
    int i = 0;
    while (i < 64)
    {
        total = total + taxForTile(city.world.tiles[i]);
        i = i + 1;
    }
    city.money.taxes = city.money.taxes + total;
    city.money.credit(total);
}

fn null updatePopulation(inout City city)
{
    settleNewcomers(city);
    evacuateFlooded(city);
    moveCrowding(city);
    collectTaxes(city);
}

// Roads affect both future climate and current traffic income.
fn int trafficForTile( Tile tile)
{
    if (tile.road == 0)
    {
        return 0;
    }
    int traffic = tile.population + tile.harvest * 2;
    if (tile.water > 24)
    {
        traffic = traffic / 2;
    }
    return traffic;
}

fn null buildRoads(inout City city)
{
    int i = 0;
    while (i < 64)
    {
        if (city.world.tiles[i].blocked == false and city.world.tiles[i].population >= 10)
        {
            if (city.world.tiles[i].road == 0)
            {
                city.world.tiles[i].road = 1;
                city.money.debit(12);
            }
        }
        i = i + 1;
    }
}

fn null damageRoads(inout City city)
{
    int i = 0;
    while (i < 64)
    {
        if (city.world.tiles[i].water > 25 and city.world.tiles[i].road > 0)
        {
            city.world.tiles[i].road = city.world.tiles[i].road - 1;
            city.warnings = city.warnings + 1;
        }
        i = i + 1;
    }
}

fn null repairRoads(inout City city)
{
    int repaired = 0;
    int i = 0;
    while (i < 64)
    {
        if (repaired == 5)
        {
            break;
        }
        if (city.world.tiles[i].blocked or city.world.tiles[i].road == 0)
        {
            i = i + 1;
            continue;
        }
        if (city.world.tiles[i].road < 3)
        {
            city.world.tiles[i].road = city.world.tiles[i].road + 1;
            city.money.debit(4);
            repaired = repaired + 1;
        }
        i = i + 1;
    }
}

fn null computeTraffic(inout City city)
{
    int i = 0;
    while (i < 64)
    {
        city.world.tiles[i].traffic = trafficForTile(city.world.tiles[i]);
        i = i + 1;
    }
}

fn int tollForTile( Tile tile)
{
    if (tile.road < 2)
    {
        return 0;
    }
    return tile.traffic / 3;
}

fn null collectTolls(inout City city)
{
    int total = 0;
    int i = 0;
    while (i < 64)
    {
        total = total + tollForTile(city.world.tiles[i]);
        i = i + 1;
    }
    city.money.tolls = city.money.tolls + total;
    city.money.credit(total);
}

fn null updateRoads(inout City city)
{
    buildRoads(city);
    damageRoads(city);
    repairRoads(city);
    computeTraffic(city);
    collectTolls(city);
}

// Extraction, sales, and maintenance feed one shared treasury.
fn int resourceYield(Tile tile)
{
    if (tile.population < 4 or tile.ore == 0)
    {
        return 0;
    }
    int amount = 1 + tile.population / 6;
    if (tile.road > 0)
    {
        amount = amount + 1;
    }
    return minimum(amount, tile.ore);
}

fn null extractResources(inout City city)
{
    int i = 0;
    while (i < 64)
    {
        int amount = resourceYield(city.world.tiles[i]);
        city.world.tiles[i].ore = city.world.tiles[i].ore - amount;
        city.world.mined = city.world.mined + amount;
        city.money.trades = city.money.trades + amount;
        city.money.credit(amount * 3);
        i = i + 1;
    }
}

fn int maintenanceCost(Tile tile)
{
    int cost = tile.road * 2;
    if (tile.population > 0)
    {
        cost = cost + 1;
    }
    if (tile.water > 22)
    {
        cost = cost + 2;
    }
    return cost;
}

fn null chargeMaintenance(inout City city)
{
    int cost = 0;
    int i = 0;
    while (i < 64)
    {
        cost = cost + maintenanceCost(city.world.tiles[i]);
        i = i + 1;
    }
    city.money.debit(cost);
}

fn null grantAid(inout City city)
{
    int i = 0;
    while (i < 64)
    {
        if (city.world.tiles[i].population > 0 and city.world.tiles[i].food < 3)
        {
            city.world.tiles[i].food = city.world.tiles[i].food + 4;
            city.money.aid = city.money.aid + 4;
            city.money.debit(6);
        }
        i = i + 1;
    }
}

fn null updateEconomy(inout City city)
{
    extractResources(city);
    chargeMaintenance(city);
    grantAid(city);
}

// Dijkstra's algorithm traverses the same evolving road/terrain graph.
fn int routeEnterCost(Tile tile)
{
    int cost = 5 + tile.elevation / 3;
    if (tile.road > 0)
    {
        cost = cost - tile.road;
    }
    if (tile.water > 23)
    {
        cost = cost + 3;
    }
    return maximum(1, cost);
}

fn Routes emptyRoutes()
{
    Routes routes;
    int i = 0;
    while (i < 64)
    {
        routes.cost[i] = 10000;
        i = i + 1;
    }
    routes.cost[0] = 0;
    return routes;
}

fn int chooseNext(in Routes routes)
{
    int chosen = 0 - 1;
    int best = 10000;
    int i = 0;
    while (i < 64)
    {
        if (routes.visited[i] == false and routes.cost[i] < best)
        {
            best = routes.cost[i];
            chosen = i;
        }
        i = i + 1;
    }
    return chosen;
}

fn null relaxRoute(in World world, inout Routes routes, int source, int x, int y)
{
    if (inside(x, y) == false)
    {
        return;
    }
    int target = tileIndex(x, y);
    if (world.tiles[target].blocked or routes.visited[target])
    {
        return;
    }
    int candidate = routes.cost[source] + routeEnterCost(world.tiles[target]);
    if (candidate < routes.cost[target])
    {
        routes.cost[target] = candidate;
    }
}

fn Routes findRoutes(in World world)
{
    Routes routes = emptyRoutes();
    int step = 0;
    while (step < 64)
    {
        int current = chooseNext(routes);
        if (current < 0)
        {
            break;
        }
        routes.visited[current] = true;
        routes.reached = routes.reached + 1;
        routes.sum = routes.sum + routes.cost[current];
        int x = remainder(current, 8);
        int y = current / 8;
        relaxRoute(world, routes, current, x - 1, y);
        relaxRoute(world, routes, current, x + 1, y);
        relaxRoute(world, routes, current, x, y - 1);
        relaxRoute(world, routes, current, x, y + 1);
        step = step + 1;
    }
    return routes;
}

fn int routeSignature(in Routes routes)
{
    int value = routes.reached * 100 + routes.sum;
    int i = 0;
    while (i < 64)
    {
        if (routes.visited[i])
        {
            value = value + routes.cost[i] * (i + 1);
        }
        i = i + 1;
    }
    return value;
}

fn null updateRoutes(inout City city)
{
    Routes routes = findRoutes(city.world);
    city.routeScore = routeSignature(routes);
    if (routes.reached < 40)
    {
        city.warnings = city.warnings + 1;
    }
}

// Each report scans one independent dimension of the simulated world.
fn RunningStats waterStats(in World world)
{
    RunningStats stats;
    int i = 0;
    while (i < 64)
    {
        stats.observe(world.tiles[i].water);
        i = i + 1;
    }
    return stats;
}

fn RunningStats foodStats(in World world)
{
    RunningStats stats;
    int i = 0;
    while (i < 64)
    {
        stats.observe(world.tiles[i].food);
        i = i + 1;
    }
    return stats;
}

fn RunningStats populationStats(in World world)
{
    RunningStats stats;
    int i = 0;
    while (i < 64)
    {
        stats.observe(world.tiles[i].population);
        i = i + 1;
    }
    return stats;
}

fn RunningStats roadStats(in World world)
{
    RunningStats stats;
    int i = 0;
    while (i < 64)
    {
        stats.observe(world.tiles[i].road);
        i = i + 1;
    }
    return stats;
}

fn RunningStats oreStats(in World world)
{
    RunningStats stats;
    int i = 0;
    while (i < 64)
    {
        stats.observe(world.tiles[i].ore);
        i = i + 1;
    }
    return stats;
}

fn RunningStats heatStats(in World world)
{
    RunningStats stats;
    int i = 0;
    while (i < 64)
    {
        stats.observe(world.tiles[i].heat);
        i = i + 1;
    }
    return stats;
}

fn int tileChecksum(Tile tile)
{
    int value = tile.elevation * 3 + tile.water * 5;
    value = value + tile.heat * 7 + tile.population * 11;
    value = value + tile.food * 13 + tile.ore * 17;
    value = value + tile.road * 19 + tile.traffic * 23;
    value = value + tile.harvest * 29;
    if (tile.blocked)
    {
        value = value + 31;
    }
    return value;
}

fn int worldChecksum(in World world)
{
    int result = 0;
    int i = 0;
    while (i < 64)
    {
        result = folded(result + tileChecksum(world.tiles[i]) * (i + 1));
        i = i + 1;
    }
    return result;
}

fn int totalNeeds(in World world)
{
    int result = 0;
    int i = 0;
    while (i < 64)
    {
        result = result + maximum(0, populationDemand(world.tiles[i]) - world.tiles[i].food);
        i = i + 1;
    }
    return result;
}

fn int totalCapacity(in World world)
{
    int result = 0;
    int i = 0;
    while (i < 64)
    {
        if (world.tiles[i].blocked == false)
        {
            result = result + 40 - world.tiles[i].population;
        }
        i = i + 1;
    }
    return result;
}

fn int healthIndex(in World world)
{
    RunningStats population = populationStats(world);
    RunningStats food = foodStats(world);
    RunningStats water = waterStats(world);
    int score = population.total * 3 + food.total;
    score = score - totalNeeds(world) * 4;
    score = score + water.average() * 5 - water.spread();
    return score;
}

fn int financeIndex(inout Treasury money)
{
    int verified = money.balance();
    int score = verified + money.trades * 2;
    score = score + money.taxes - money.aid;
    score = score + money.tolls * 3;
    return score;
}

fn Report makeReport(inout City city)
{
    RunningStats water = waterStats(city.world);
    RunningStats food = foodStats(city.world);
    RunningStats population = populationStats(city.world);
    RunningStats roads = roadStats(city.world);
    RunningStats ore = oreStats(city.world);
    RunningStats heat = heatStats(city.world);
    Report report;
    report.water = water.total;
    report.food = food.total;
    report.population = population.total;
    report.roads = roads.total;
    report.ore = ore.total;
    report.heat = heat.total;
    report.health = healthIndex(city.world);
    report.finance = financeIndex(city.money);
    report.routes = city.routeScore;
    report.checksum = worldChecksum(city.world);
    return report;
}

fn int reportSignature(Report report)
{
    int value = report.water + report.food * 2;
    value = value + report.population * 3 + report.roads * 5;
    value = value + report.ore * 7 + report.heat * 11;
    value = value + report.health + report.finance;
    value = value + report.routes + report.checksum;
    return folded(value);
}

fn null recordHistory(inout City city)
{
    Report report = makeReport(city);
    city.history = folded(city.history * 7 + reportSignature(report));
}

fn null runDay(inout City city)
{
    city.world.day = city.world.day + 1;
    updateClimate(city);
    updateAgriculture(city);
    updatePopulation(city);
    updateRoads(city);
    updateEconomy(city);
    updateRoutes(city);
    recordHistory(city);
}

fn null runSeason(inout City city)
{
    int day = 0;
    while (day < 4)
    {
        runDay(city);
        echo worldChecksum(city.world);
        echo city.money.cash;
        echo city.history;
        day = day + 1;
    }
}

// A heap snapshot verifies aggregate copies and reference aliasing.
fn Tile[]& snapshotWorld(in World world)
{
    Tile[]& snapshot = new Tile[64]&;
    int i = 0;
    while (i < snapshot.length)
    {
        snapshot[i] = world.tiles[i];
        i = i + 1;
    }
    return snapshot;
}

fn int snapshotChecksum(Tile[]& snapshot)
{
    int result = 0;
    int i = 0;
    while (i < snapshot.length)
    {
        result = folded(result + tileChecksum(snapshot[i]) * (i + 1));
        i = i + 1;
    }
    return result;
}

fn null updateSnapshot(Tile[]& snapshot)
{
    int i = 0;
    while (i < snapshot.length)
    {
        if (remainder(i, 3) == 0)
        {
            snapshot[i].food = snapshot[i].food + 2;
        }
        if (remainder(i, 5) == 0)
        {
            snapshot[i].ore = snapshot[i].ore + 1;
        }
        i = i + 1;
    }
}

fn int snapshotDifference(in World world, Tile[]& snapshot)
{
    int difference = 0;
    int i = 0;
    while (i < snapshot.length)
    {
        difference = difference + absolute(snapshot[i].food - world.tiles[i].food);
        difference = difference + absolute(snapshot[i].ore - world.tiles[i].ore);
        i = i + 1;
    }
    return difference;
}

fn int referenceAudit(inout City city)
{
    Report report = makeReport(city);
    Report& first = new Report& { report };
    Report& alias = first;
    alias.health = alias.health + 7;
    int& counter = new int& { report.population };
    counter.value = counter.value + first.health;
    return counter.value + first.finance + first.routes;
}

// Binary fractions keep numeric conversion checkpoints exact.
fn float densityScore(int population, int capacity)
{
    float populationScore = (population as float) * 0.5f;
    float capacityScore = (capacity as float) * 0.25f;
    return populationScore + capacityScore;
}

fn double climateScore(int water, int heat)
{
    double wet = (water as double) * 0.5;
    double hot = (heat as double) * 0.25;
    return wet - hot;
}

fn int numericReport(inout City city)
{
    Report report = makeReport(city);
    int capacity = totalCapacity(city.world);
    float density = densityScore(report.population, capacity);
    double climate = climateScore(report.water, report.heat);
    double combined = (density as double) + climate;
    return (combined * 4.0) as int;
}

// Independent invariants check every tile and aggregate after all mutations.
fn null inspectTile(Tile tile, inout Inspection inspection)
{
    inspection.check(tile.elevation >= 0 and tile.elevation <= 12, 1);
    inspection.check(tile.water >= 0 and tile.water <= 80, 2);
    inspection.check(tile.heat >= 0 and tile.heat <= 40, 3);
    inspection.check(tile.population >= 0 and tile.population <= 40, 5);
    inspection.check(tile.food >= 0, 7);
    inspection.check(tile.ore >= 0, 11);
    inspection.check(tile.road >= 0 and tile.road <= 3, 13);
    inspection.check(tile.traffic >= 0, 17);
    inspection.check(tile.harvest >= 0, 19);
    if (tile.blocked)
    {
        inspection.check(tile.population == 0, 23);
    }
}

fn null inspectTreasury(inout Treasury money, inout Inspection inspection)
{
    inspection.check(money.cash == money.balance(), 29);
    inspection.check(money.income >= money.taxes + money.tolls, 31);
    inspection.check(money.expense > 0, 37);
    inspection.check(money.trades > 0, 41);
    inspection.check(money.aid >= 0, 43);
}

fn null inspectRoutes(in World world, inout Inspection inspection)
{
    Routes routes = findRoutes(world);
    inspection.check(routes.cost[0] == 0, 47);
    inspection.check(routes.visited[0], 53);
    inspection.check(routes.reached > 0 and routes.reached <= 64, 59);
    int i = 0;
    while (i < 64)
    {
        if (routes.visited[i])
        {
            inspection.check(routes.cost[i] >= 0 and routes.cost[i] < 10000, 61);
        }
        else
        {
            inspection.check(routes.cost[i] == 10000, 67);
        }
        i = i + 1;
    }
}

fn null inspectConservation(in City city, inout Inspection inspection)
{
    RunningStats food = foodStats(city.world);
    RunningStats ore = oreStats(city.world);
    inspection.check(city.world.produced > 0, 71);
    inspection.check(city.world.eaten > city.world.produced, 73);
    inspection.check(city.world.mined + ore.total == 1205, 79);
    inspection.check(city.world.rain > city.world.drained, 83);
    inspection.check(food.total >= 0, 89);
    inspection.check(city.world.emigrated >= 0, 97);
}

fn Inspection inspectCity(inout City city)
{
    Inspection inspection;
    int i = 0;
    while (i < 64)
    {
        inspectTile(city.world.tiles[i], inspection);
        i = i + 1;
    }
    inspectTreasury(city.money, inspection);
    inspectRoutes(city.world, inspection);
    inspectConservation(city, inspection);
    inspection.check(city.world.day == 4, 101);
    inspection.check(city.history >= 0 and city.history < 1000003, 103);
    return inspection;
}

// Regional relief planning consumes the final harvest and transport state.
struct Forecast
{
    int[4] demand;
    int[4] supply;
    int[4] population;
    int moved;
    int transport;
    int originalSupply;
}

fn int quadrantFor(int x, int y)
{
    return (y / 4) * 2 + x / 4;
}

fn Forecast buildForecast(in World world)
{
    Forecast forecast;
    int y = 0;
    while (y < 8)
    {
        int x = 0;
        while (x < 8)
        {
            int i = tileIndex(x, y);
            int region = quadrantFor(x, y);
            int supply = world.tiles[i].food + world.tiles[i].harvest * 2;
            // Eastern districts wait an extra day for their next delivery.
            int leadDays = 2 + remainder(region, 2);
            forecast.demand[region] = forecast.demand[region] + populationDemand(world.tiles[i]) * leadDays;
            forecast.supply[region] = forecast.supply[region] + supply;
            forecast.population[region] = forecast.population[region] + world.tiles[i].population;
            forecast.originalSupply = forecast.originalSupply + supply;
            x = x + 1;
        }
        y = y + 1;
    }
    return forecast;
}

fn int availableFood(in Forecast forecast, int region)
{
    int supply = forecast.supply[region];
    int demand = forecast.demand[region];
    if (supply > demand)
    {
        return supply - demand;
    }
    return 0;
}

fn int unmetDemand(in Forecast forecast, int region)
{
    int supply = forecast.supply[region];
    int demand = forecast.demand[region];
    if (supply < demand)
    {
        return demand - supply;
    }
    return 0;
}

fn null moveRelief(inout Forecast forecast, int source, int target)
{
    int available = availableFood(forecast, source);
    int needed = unmetDemand(forecast, target);
    int amount = minimum(available, needed);
    forecast.supply[source] = forecast.supply[source] - amount;
    forecast.supply[target] = forecast.supply[target] + amount;
    forecast.moved = forecast.moved + amount;
    int distance = absolute(source / 2 - target / 2);
    distance = distance + absolute(remainder(source, 2) - remainder(target, 2));
    forecast.transport = forecast.transport + amount * distance;
}

fn null planRelief(inout Forecast forecast)
{
    int source = 0;
    while (source < 4)
    {
        int target = 3;
        while (target >= 0)
        {
            if (source != target)
            {
                moveRelief(forecast, source, target);
            }
            target = target - 1;
        }
        source = source + 1;
    }
}

fn int forecastChecksum(in Forecast forecast)
{
    int signature = forecast.moved * 7 + forecast.transport * 11;
    int i = 0;
    while (i < 4)
    {
        int value = forecast.demand[i] * 3 + forecast.supply[i] * 5;
        value = value + forecast.population[i] * 7;
        signature = signature + value * (i + 1);
        i = i + 1;
    }
    return signature;
}

fn int forecastRisk(in Forecast forecast)
{
    int total = 0;
    int i = 0;
    while (i < 4)
    {
        int missing = unmetDemand(forecast, i);
        total = total + missing * (i + 1);
        if (missing > forecast.population[i] / 2)
        {
            total = total + 100;
        }
        i = i + 1;
    }
    return total;
}

fn null inspectForecast(in Forecast forecast, inout Inspection inspection)
{
    int supply = 0;
    int i = 0;
    while (i < 4)
    {
        supply = supply + forecast.supply[i];
        inspection.check(forecast.supply[i] >= 0, 107);
        inspection.check(forecast.demand[i] >= forecast.population[i], 109);
        i = i + 1;
    }
    inspection.check(supply == forecast.originalSupply, 113);
    inspection.check(forecast.transport >= forecast.moved, 127);
}

fn bool program()
{
    City city = seedCity();
    echo worldChecksum(city.world);
    runSeason(city);

    Report report = makeReport(city);
    echo report.water;
    echo report.food;
    echo report.population;
    echo report.roads;
    echo report.ore;
    echo report.heat;
    echo report.health;
    echo report.finance;
    echo report.routes;
    echo reportSignature(report);

    Tile[]& snapshot = snapshotWorld(city.world);
    echo snapshot.length;
    echo snapshot.capacity;
    echo snapshotChecksum(snapshot);
    Tile[]& alias = snapshot;
    updateSnapshot(alias);
    echo snapshotChecksum(snapshot);
    echo snapshotDifference(city.world, snapshot);
    echo worldChecksum(city.world);

    echo referenceAudit(city);
    echo numericReport(city);
    echo city.warnings;
    echo city.world.produced;
    echo city.world.eaten;
    echo city.world.mined;
    echo city.world.emigrated;

    Forecast forecast = buildForecast(city.world);
    echo forecastChecksum(forecast);
    echo forecastRisk(forecast);
    planRelief(forecast);
    echo forecastChecksum(forecast);
    echo forecastRisk(forecast);
    echo forecast.moved;
    echo forecast.transport;

    Inspection inspection = inspectCity(city);
    inspectForecast(forecast, inspection);
    echo inspection.errors;
    echo inspection.checks;
    echo inspection.signature;
    return inspection.errors != 0;
}
