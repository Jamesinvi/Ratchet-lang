// Compilation benchmark: borrowed structs, arrays and fields, plus forwarding calls.
// Work is in the source structure; runtime loops stay small.

struct Totals {
    int accepted;
    int rejected;
    double balance;
}

struct Ledger {
    Totals totals;
    int[8] buckets;
}

fn null addCount(inout int count, int amount) {
    count = count + amount;
}

fn null addBalance(inout double balance, double amount) {
    balance = balance + amount;
}

fn null record(inout Ledger ledger, int slot, int amount) {
    addCount(ledger.totals.accepted, amount);
    addBalance(ledger.totals.balance, (amount as double) * 1.25);
    ledger.buckets[slot] = ledger.buckets[slot] + amount;
}

fn int bucketSum(in int[8] buckets) {
    int total = 0;
    int index = 0;
    while (index < 8) {
        total = total + buckets[index];
        index = index + 1;
    }
    return total;
}

fn int inspect(in Ledger ledger) {
    return bucketSum(ledger.buckets) + ledger.totals.accepted;
}

fn null forwardRecord(inout Ledger ledger, int slot, int amount) {
    record(ledger, slot, amount);
}

fn int reconcile0(int seed) {
    Ledger ledger;
    int index = 0;
    while (index < 8) {
        forwardRecord(ledger, index, seed + index + 2);
        if (index > 3) {
            addCount(ledger.totals.rejected, 1);
        }
        index = index + 1;
    }
    int total = inspect(ledger);
    addBalance(ledger.totals.balance, 0.5);
    int balance = ledger.totals.balance as int;
    return total + balance - ledger.totals.rejected;
}

