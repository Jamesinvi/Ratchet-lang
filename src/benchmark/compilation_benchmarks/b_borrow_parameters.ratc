fn bool program() {
    int checksum = 0;
    checksum = checksum + reconcile0(5);
    checksum = checksum + reconcile1(6);
    checksum = checksum + reconcile2(7);
    checksum = checksum + reconcile3(8);
    checksum = checksum + reconcile4(9);
    checksum = checksum + reconcile5(10);
    checksum = checksum + reconcile6(11);
    checksum = checksum + reconcile7(12);
    checksum = checksum + reconcile8(13);
    checksum = checksum + reconcile9(14);
    echo checksum;
    return false;
}
