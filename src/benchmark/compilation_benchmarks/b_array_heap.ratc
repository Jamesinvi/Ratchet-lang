fn bool program() {
    int checksum = 0;
    checksum = checksum + scanBuffer0(5);
    checksum = checksum + scanBuffer1(6);
    checksum = checksum + scanBuffer2(7);
    checksum = checksum + scanBuffer3(8);
    checksum = checksum + scanBuffer4(9);
    checksum = checksum + scanBuffer5(10);
    checksum = checksum + scanBuffer6(11);
    checksum = checksum + scanBuffer7(12);
    checksum = checksum + scanBuffer8(13);
    checksum = checksum + scanBuffer9(14);
    checksum = checksum + scanBuffer10(15);
    checksum = checksum + scanBuffer11(16);
    echo checksum;
    return false;
}
