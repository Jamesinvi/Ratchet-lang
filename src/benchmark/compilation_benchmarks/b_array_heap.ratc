// Compilation benchmark: dynamic array types, struct/reference elements, and mixed projections.
// Work is in the source structure; runtime loops stay small.

struct Sample {
    int count;
    double total;
    int[4] bins;
}

fn int scanBuffer0(int seed) {
    int length = 8 + 0;
    int[]& values = new int[length]&;
    Sample[]& samples = new Sample[4]&;
    Sample&[]& references = new Sample&[4]&;
    int[]* scratch = new int[4]*;
    int index = 0;
    while (index < length) {
        values[index] = seed + index * 2;
        index = index + 1;
    }
    int lane = seed - (seed / 4) * 4;
    samples[lane].count = values[lane + 4];
    samples[lane].total = (values[lane] as double) * 1.5;
    samples[lane].bins[2] = values[lane + 1];
    Sample snapshot = samples[lane];
    references[lane] = new Sample& { snapshot };
    references[lane].bins[3] = references[lane].bins[2] + 2;
    scratch[lane] = references[lane].count;
    int[]& alias = values;
    alias[lane] = scratch[lane] + samples[lane].bins[2];
    return alias[lane] + references[lane].bins[3] + (references[lane].total as int);
}

