fn int quote1(int base, int units) {
    int prior = quote0(base / 2, units);
    int first = addFee(base, blend(units, 3, 2));
    int second = blend(addFee(base, units), addFee(units, 6), 3);
    int bounded = clampPrice(blend(first, second, 2), 1, 5000);
    double taxed = applyRate(addFee(bounded, prior), 1.125);
    int rounded = taxed as int;
    int handling = addFee(blend(units, prior, 4), 3);
    int result = blend(rounded, handling, 2);
    int floor = clampPrice(prior, 1, 100);
    return addFee(clampPrice(result, floor, 6000), units);
}

fn int quote0(int base, int units) {
    int prior = addFee(base, units);
    int first = addFee(base, blend(units, 2, 2));
    int second = blend(addFee(base, units), addFee(units, 5), 3);
    int bounded = clampPrice(blend(first, second, 2), 1, 5000);
    double taxed = applyRate(addFee(bounded, prior), 1.125);
    int rounded = taxed as int;
    int handling = addFee(blend(units, prior, 4), 2);
    int result = blend(rounded, handling, 2);
    int floor = clampPrice(prior, 1, 100);
    return addFee(clampPrice(result, floor, 6000), units);
}

fn bool program() {
    int checksum = 0;
    checksum = checksum + quote0(40, 2);
    checksum = checksum + quote1(41, 3);
    checksum = checksum + quote2(42, 4);
    checksum = checksum + quote3(43, 5);
    checksum = checksum + quote4(44, 6);
    checksum = checksum + quote5(45, 7);
    checksum = checksum + quote6(46, 8);
    checksum = checksum + quote7(47, 9);
    checksum = checksum + quote8(48, 10);
    checksum = checksum + quote9(49, 11);
    checksum = checksum + quote10(50, 12);
    checksum = checksum + quote11(51, 13);
    echo checksum;
    return false;
}
