// Compilation benchmark: nested arguments, forward declarations, and a typed call graph.
// Work is in the source structure; runtime loops stay small.

fn int addFee(int amount, int fee) {
    return amount + fee;
}

fn int blend(int left, int right, int weight) {
    return (left * weight + right) / (weight + 1);
}

fn int clampPrice(int value, int low, int high) {
    if (value < low) {
        return low;
    }
    if (value > high) {
        return high;
    }
    return value;
}

fn double applyRate(int value, double rate) {
    return (value as double) * rate;
}

fn int quote11(int base, int units) {
    int prior = quote10(base / 2, units);
    int first = addFee(base, blend(units, 13, 2));
    int second = blend(addFee(base, units), addFee(units, 16), 3);
    int bounded = clampPrice(blend(first, second, 2), 1, 5000);
    double taxed = applyRate(addFee(bounded, prior), 1.125);
    int rounded = taxed as int;
    int handling = addFee(blend(units, prior, 4), 13);
    int result = blend(rounded, handling, 2);
    int floor = clampPrice(prior, 1, 100);
    return addFee(clampPrice(result, floor, 6000), units);
}

fn int quote10(int base, int units) {
    int prior = quote9(base / 2, units);
    int first = addFee(base, blend(units, 12, 2));
    int second = blend(addFee(base, units), addFee(units, 15), 3);
    int bounded = clampPrice(blend(first, second, 2), 1, 5000);
    double taxed = applyRate(addFee(bounded, prior), 1.125);
    int rounded = taxed as int;
    int handling = addFee(blend(units, prior, 4), 12);
    int result = blend(rounded, handling, 2);
    int floor = clampPrice(prior, 1, 100);
    return addFee(clampPrice(result, floor, 6000), units);
}

