// Compilation benchmark: nested integer expressions, precedence, and local bindings.
// Work is in the source structure; runtime loops stay small.

fn int priceBand0(int base, int units) {
    int gross = (base + 3) * (units + 2);
    int shipping = (units * 5 + base / 3) / 2;
    int discount = (gross / 7 + shipping) / 3;
    int taxable = gross + shipping - discount;
    int tax = (taxable * 7 + 99) / 100;
    int subtotal = taxable + tax;
    int rounded = ((subtotal + 4) / 5) * 5;
    int fee = (base * base + units * units + 5) / 11;
    int reserve = (rounded + fee * 3) / 8;
    int adjusted = rounded + fee - reserve;
    int remainder = adjusted - (adjusted / 97) * 97;
    int weighted = (adjusted * 3 + remainder * 3) / 4;
    return weighted + (gross - discount) / 9;
}

