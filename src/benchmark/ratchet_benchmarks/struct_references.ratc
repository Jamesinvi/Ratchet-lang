// Compilation benchmark: nested managed references, alias assignments, and method calls.
// Work is in the source structure; runtime loops stay small.

struct Vec2 {
    float x;
    float y;
}

struct Material {
    double mass;
    float drag;
}

struct Settings {
    int limit;
    Material& material;
}

struct Entity {
    Vec2 position;
    Vec2 velocity;
    Settings& settings;

    method null advance(float delta) {
        this.position.x = this.position.x + this.velocity.x * delta;
        this.position.y = this.position.y + this.velocity.y * delta;
    }
}

fn int updateEntity0(int seed) {
    Material material;
    material.mass = 2.5;
    material.drag = 0.125f;
    Settings settings;
    settings.limit = 100 + seed;
    settings.material = new Material& { material };
    Entity initial;
    initial.position.x = seed as float;
    initial.position.y = 3.0f;
    initial.velocity.x = 1.5f;
    initial.velocity.y = 0.5f;
    initial.settings = new Settings& { settings };
    initial.advance(0.5f);
    Entity& entity = new Entity& { initial };
    Entity& alias = entity;
    alias.settings.material.mass = alias.settings.material.mass + 0.25;
    entity.velocity.x = entity.velocity.x * (1.0f - entity.settings.material.drag);
    if (entity.position.x > (entity.settings.limit as float)) {
        entity.position.x = 0.0f;
    }
    double weighted = (alias.position.y as double) * entity.settings.material.mass;
    return (weighted as int) + (entity.velocity.x as int);
}

