// Compilation benchmark: nested value layouts, struct copies, fields, and method receivers.
// Work is in the source structure; runtime loops stay small.

struct Vec2 {
    float x;
    float y;

    method null translate(float dx, float dy) {
        this.x = this.x + dx;
        this.y = this.y + dy;
    }
}

struct Bounds {
    Vec2 low;
    Vec2 high;
}

struct Material {
    double mass;
    float drag;
    int tag;
}

struct Particle {
    Vec2 position;
    Vec2 velocity;
    Bounds bounds;
    Material material;

    method double energy() {
        double x = this.velocity.x as double;
        double y = this.velocity.y as double;
        return (x * x + y * y) * this.material.mass * 0.5;
    }
}

fn int moveParticle0(float delta) {
    Particle particle;
    particle.position.x = 1.0f;
    particle.position.y = 4.0f;
    particle.velocity.x = delta * 2.0f;
    particle.velocity.y = delta * 3.0f;
    particle.bounds.high.x = 100.0f;
    particle.bounds.high.y = 80.0f;
    particle.material.mass = 1.25;
    particle.material.drag = 0.125f;
    particle.material.tag = 0;
    particle.position.translate(particle.velocity.x, particle.velocity.y);
    Particle snapshot = particle;
    snapshot.velocity.x = snapshot.velocity.x * (1.0f - snapshot.material.drag);
    snapshot.velocity.y = snapshot.velocity.y * (1.0f - snapshot.material.drag);
    if (snapshot.position.x > snapshot.bounds.high.x) {
        snapshot.position.x = snapshot.bounds.low.x;
    }
    double energy = snapshot.energy();
    return (energy as int) + (snapshot.position.y as int) + snapshot.material.tag;
}

