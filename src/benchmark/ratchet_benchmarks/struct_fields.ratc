fn bool program() {
    int checksum = 0;
    checksum = checksum + moveParticle0(1.5f);
    checksum = checksum + moveParticle1(2.5f);
    checksum = checksum + moveParticle2(3.5f);
    checksum = checksum + moveParticle3(4.5f);
    checksum = checksum + moveParticle4(5.5f);
    checksum = checksum + moveParticle5(6.5f);
    checksum = checksum + moveParticle6(7.5f);
    checksum = checksum + moveParticle7(8.5f);
    checksum = checksum + moveParticle8(9.5f);
    checksum = checksum + moveParticle9(10.5f);
    echo checksum;
    return false;
}
