// Compilation benchmark: float/double expressions, casts, and typed comparisons.
// Work is in the source structure; runtime loops stay small.

fn double calibrateBand0(float sample, double bias, int count) {
    float gain = 0.5f + (count as float) * 0.125f;
    float scaled = (sample + 1.0f) * gain;
    float correction = (sample * sample + scaled) / 8.0f;
    double precise = (scaled as double) + bias;
    double weighted = precise * 0.75 + (correction as double) * 0.25;
    double baseline = (sample as double) / 4.0 + 2.125;
    double error = weighted - baseline;
    float feedback = (error / 16.0) as float;
    float adjusted = scaled - feedback;
    double total = weighted + (adjusted as double);
    double average = total / ((count + 1) as double);
    if (average > baseline) {
        average = (average + baseline * 3.0) / 4.0;
    } else {
        average = average + (gain as double) * 0.5;
    }
    return average + (feedback as double) / 8.0;
}

