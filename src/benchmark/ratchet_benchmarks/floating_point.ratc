fn bool program() {
    int checksum = 0;
    checksum = checksum + (calibrateBand0(2.5f, 1.25, 3) as int);
    checksum = checksum + (calibrateBand1(3.5f, 2.25, 4) as int);
    checksum = checksum + (calibrateBand2(4.5f, 3.25, 5) as int);
    checksum = checksum + (calibrateBand3(5.5f, 4.25, 6) as int);
    checksum = checksum + (calibrateBand4(6.5f, 5.25, 7) as int);
    checksum = checksum + (calibrateBand5(7.5f, 6.25, 8) as int);
    checksum = checksum + (calibrateBand6(8.5f, 7.25, 9) as int);
    checksum = checksum + (calibrateBand7(9.5f, 8.25, 10) as int);
    checksum = checksum + (calibrateBand8(10.5f, 9.25, 11) as int);
    checksum = checksum + (calibrateBand9(11.5f, 10.25, 12) as int);
    checksum = checksum + (calibrateBand10(12.5f, 11.25, 13) as int);
    checksum = checksum + (calibrateBand11(13.5f, 12.25, 14) as int);
    echo checksum;
    return false;
}
