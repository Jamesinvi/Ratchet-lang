fn bool program() {
    int checksum = 0;
    checksum = checksum + routeBatch0(7, 13);
    checksum = checksum + routeBatch1(8, 14);
    checksum = checksum + routeBatch2(9, 15);
    checksum = checksum + routeBatch3(10, 16);
    checksum = checksum + routeBatch4(11, 17);
    checksum = checksum + routeBatch5(12, 18);
    checksum = checksum + routeBatch6(13, 19);
    checksum = checksum + routeBatch7(14, 20);
    echo checksum;
    return false;
}
