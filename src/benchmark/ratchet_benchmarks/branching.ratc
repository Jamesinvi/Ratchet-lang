// Compilation benchmark: nested scopes, conditions, loops, break, and continue.
// Work is in the source structure; runtime loops stay small.

fn int routeBatch0(int seed, int limit) {
    int total = 0;
    int row = 0;
    while (row < 4) {
        int column = 0;
        while (column < 6) {
            column = column + 1;
            int value = (seed + row * 3 + column * 2) / 2;
            if (value == limit) {
                continue;
            }
            if (value > limit * 4) {
                break;
            }
            bool urgent = value > limit and column < 4;
            if (urgent or row == 0) {
                int premium = value + row * 3;
                if (premium > limit * 2) {
                    total = total + premium / 2;
                } else {
                    total = total + premium + 1;
                }
            } else {
                int standard = value - value / 3;
                if (column == 5 or row == 3) {
                    total = total + standard / 2;
                } else {
                    total = total + standard;
                }
            }
        }
        row = row + 1;
    }
    return total;
}

