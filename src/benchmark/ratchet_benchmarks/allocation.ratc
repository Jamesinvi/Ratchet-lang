fn bool program() {
    int checksum = 0;
    checksum = checksum + packOrder0(5);
    checksum = checksum + packOrder1(6);
    checksum = checksum + packOrder2(7);
    checksum = checksum + packOrder3(8);
    checksum = checksum + packOrder4(9);
    checksum = checksum + packOrder5(10);
    checksum = checksum + packOrder6(11);
    checksum = checksum + packOrder7(12);
    checksum = checksum + packOrder8(13);
    checksum = checksum + packOrder9(14);
    echo checksum;
    return false;
}
