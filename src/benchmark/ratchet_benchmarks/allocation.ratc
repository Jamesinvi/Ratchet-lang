// Compilation benchmark: managed scalar, struct, and array construction with typed initializers.
// Work is in the source structure; runtime loops stay small.

struct Receipt {
    int quantity;
    double cost;
    int& discount;
}

struct Package {
    Receipt& receipt;
    float& weight;
    int[]& tracking;
}

fn int packOrder0(int seed) {
    int& quantity = new int& { seed + 1 };
    double& rate = new double& { 2.25 };
    float& weight = new float& { 1.5f };
    bool& priority = new bool& { seed > 1 };
    int[]& tracking = new int[8 + 0]&;
    Receipt initial;
    initial.quantity = quantity.value;
    initial.cost = rate.value * (quantity.value as double);
    initial.discount = new int& { 2 };
    Receipt& receipt = new Receipt& { initial };
    Package package;
    package.receipt = receipt;
    package.weight = weight;
    package.tracking = tracking;
    Package& stored = new Package& { package };
    stored.tracking[0] = stored.receipt.quantity;
    stored.tracking[1] = stored.receipt.discount.value;
    stored.weight.value = stored.weight.value + 0.5f;
    if (priority.value) {
        stored.receipt.discount.value = stored.receipt.discount.value + 1;
    }
    return (stored.receipt.cost as int) + stored.tracking[0] + stored.tracking[1];
}

