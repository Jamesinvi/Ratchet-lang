fn bool program() {
    int checksum = 0;
    checksum = checksum + scanWindow0(5);
    checksum = checksum + scanWindow1(6);
    checksum = checksum + scanWindow2(7);
    checksum = checksum + scanWindow3(8);
    checksum = checksum + scanWindow4(9);
    checksum = checksum + scanWindow5(10);
    checksum = checksum + scanWindow6(11);
    checksum = checksum + scanWindow7(12);
    checksum = checksum + scanWindow8(13);
    checksum = checksum + scanWindow9(14);
    checksum = checksum + scanWindow10(15);
    checksum = checksum + scanWindow11(16);
    echo checksum;
    return false;
}
