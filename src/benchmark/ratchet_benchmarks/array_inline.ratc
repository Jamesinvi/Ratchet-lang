// Compilation benchmark: inline array types, chained projections, indexed reads/writes, and copies.
// Work is in the source structure; runtime loops stay small.

struct Sample {
    int count;
    double total;
    int[4] bins;
}

struct Window {
    Sample[4] samples;
    int[16] values;
}

fn int scanWindow0(int seed) {
    Window window;
    bool[4] selected;
    float[4] weights;
    int index = 0;
    while (index < 16) {
        window.values[index] = seed + index * 2;
        index = index + 1;
    }
    int lane = seed - (seed / 4) * 4;
    selected[lane] = true;
    weights[lane] = 0.5f + (lane as float) * 0.125f;
    window.samples[lane].count = window.values[lane + 4];
    window.samples[lane].total = (window.values[lane] as double) * 1.25;
    window.samples[lane].bins[2] = window.values[lane + 8];
    Sample snapshot = window.samples[lane];
    int[4] saved = snapshot.bins;
    int result = snapshot.count + saved[2];
    if (selected[lane]) {
        result = result + ((weights[lane] as double) * snapshot.total as int);
    }
    return result;
}

